<resources>

    <!-- Tema base moderno (Material, disponible desde API 21) -->
    <style name="AppBaseTheme" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="AppTheme" parent="AppBaseTheme" />

    <!-- Tema a pantalla completa para las tres pantallas -->
    <style name="FullscreenTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@color/fondo_oscuro</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Estilo común de los botones principales -->
    <style name="BotonPrincipal">
        <item name="android:layout_width">240dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:drawableTint">@color/white</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:paddingLeft">24dp</item>
        <item name="android:paddingRight">24dp</item>
        <item name="android:elevation">4dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

</resources>
